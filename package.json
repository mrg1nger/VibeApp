{
  "name": "vibeapp",
  "version": "0.1.0",
  "description": "A friendly desktop app for vibe coding with Claude Code and Codex together",
  "main": "./out/main/index.js",
  "author": "Chris",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && (electron-builder --win || electron-builder --win)",
    "package:dir": "electron-vite build && electron-builder --win --dir",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs unit",
    "smoke": "node scripts/test.mjs smoke",
    "e2e": "node tests/e2e/app.e2e.mjs",
    "e2e:remote": "node tests/e2e/remote.e2e.mjs",
    "e2e:mobile": "node tests/e2e/mobile.e2e.mjs",
    "postinstall": "patch-package && electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^5.5.0",
    "simple-git": "^4.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.3"
  }
}
